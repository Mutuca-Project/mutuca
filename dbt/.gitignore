venv/
.venv/
env/

# Bytecode
__pycache__/
*.py[cod]
*$py.class

# Packaging
*.egg-info/
dist/
build/

# =====================================================
# Test & coverage (se houver)
# =====================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

