# =====================================================
# dbt core artifacts (runtime)
# =====================================================

# Compiled models, manifests & run artifacts
target/

# dbt dependencies (packages)
dbt_packages/
dbt_modules/

nbs/data/*.*
nbs/assets/**
# Logs
logs/
*.log

# =====================================================
# dbt local state
# =====================================================

# Partial parsing cache
.partial_parse.msgpack

# Local dbt profiles (NUNCA versionar — exceto branch_validator que usa só env_var)
profiles.yml
!branch_validator/profiles.yml

# Environment overrides
.env
.env.*
.envrc

