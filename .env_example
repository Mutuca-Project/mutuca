# --- PROJECT SETTINGS ---
PROJECT_NAME=mutuca-lakehouse
TZ=America/Sao_Paulo

# --- MINIO (Object Storage) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_admin_password
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_ENDPOINT="http://minio:9000"

# --- POSTGRESQL (Metastore Compartilhado) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=adminpass
POSTGRES_DB=postgres

# --- AIRFLOW SECURITY ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_super_secreto
AIRFLOW_ADMIN_EMAIL=admin@lakehouse.com.br

# --- STORAGE — HD EXTERNO (opcional) ---

# Necessário apenas ao usar `make up-hd` (MinIO com bind mount no HD externo).
# Ignorado no modo padrão `make up` (MinIO usa volume Docker local).
# O diretório deve existir antes do primeiro `make up-hd`.
# Exemplo: /media/datafixer/Expansion/DATALAKE/MINIO
MINIO_DATA_PATH=/media/seu-usuario/HD-externo/MINIO

# --- PIPELINES — FONTES EXTERNAS ---

# RFB CNPJ: caminho no host do HD externo com os CSVs da Receita Federal.
# Será montado em /mnt/hd_rfb dentro do container Airflow (read-only).
# Comente esta linha se o HD não estiver conectado para evitar erro na inicialização.
# Exemplo: /media/datafixer/f57a7a83-c2e6-48e4-a82c-bdfa502ac0bf/rfb_cnpj
RFB_CNPJ_HD_PATH=/media/seu-usuario/<UUID-do-HD>/rfb_cnpj
